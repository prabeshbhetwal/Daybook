.DS_Store
__pycache__/
.superpowers/
.worktrees/
/_trash/
/Daybook.app/
/.build/
/snapshots/
/task-*-report.md
# Design research and handoff exports stay local; they are not part of the
# public repository.
/research/
/graphify-out/
/.codegraph/
/.code-review-graph/
/.10x/

# iCloud File Provider conflict copies of the built bundle
/Daybook *.app/

# Claude Code harness state (worktrees, scratch) stays local. The project's
# shared settings, hooks, skills and agents are committed so every worktree
# gets them.
**/.claude/*
!/.claude/settings.json
!/.claude/hooks/
!/.claude/skills/
!/.claude/agents/
